if DZSWGB and DZSWGB.version~="test12-20261109" then error("Another Deity Zenith SWGB build is loaded in this CE session. Restart Cheat Engine normally first.",0) end
if not DZSWGB then
-- Deity Zenith Galactic Battlegrounds / Bener Kaya — test12
-- Ordinary Cheat Engine rows. No custom form, automatic attachment or patch on load.
assert(not DZSWGB,'Disable the old Deity Zenith table and restart CE before opening another copy. Old builds also require a normal game restart.')
