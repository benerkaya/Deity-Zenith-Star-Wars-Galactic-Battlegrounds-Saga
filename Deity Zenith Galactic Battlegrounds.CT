local MANIFEST={["abi_version"]=786433,["mouse_sequence_offset"]=212,["mouse_held_offset"]=216,["pick_result_offset"]=512,["pick_result_size"]=20,["pick_before_canary"]=508,["pick_after_canary"]=532,["bytes"]="",["relocations"]={{["offset"]=3,["kind"]="data",["add"]=0},{["offset"]=1642,["kind"]="data",["add"]=0},{["offset"]=1729,["kind"]="data",["add"]=0},{["offset"]=1559,["kind"]="module",["add"]=3810044},{["offset"]=1782,["kind"]="module",["add"]=2766468},{["offset"]=2765,["kind"]="module",["add"]=2766468},{["offset"]=2386,["kind"]="code",["add"]=0},{["offset"]=2610,["kind"]="code",["add"]=0},{["offset"]=2403,["kind"]="code",["add"]=1639},{["offset"]=1564,["kind"]="relative_module",["add"]=2118393},{["offset"]=2290,["kind"]="relative_module",["add"]=2028160},{["offset"]=2615,["kind"]="size",["add"]=0},{["offset"]=2691,["kind"]="data",["add"]=256},{["offset"]=2738,["kind"]="data",["add"]=260},{["offset"]=2760,["kind"]="data",["add"]=264},{["offset"]=2856,["kind"]="data",["add"]=268},{["offset"]=2869,["kind"]="data",["add"]=268},{["offset"]=2909,["kind"]="data",["add"]=272},{["offset"]=2953,["kind"]="data",["add"]=276}},["native_call_rvas"]={797968,2095360,1402048,2304940,2184240,2182928},["size"]=2981,["guarded_native_wrapper"]=true,["source_master_override"]=true,["source_factory_offset"]=1639,["header_guard_offset"]=2294,["key_hook_offset"]=1726}
local ORIGINAL={0xA1,0xFC,0x22,0x7A,0}
local WINORIGINAL={0x81,0xFF,0x01,0x02,0x00,0x00}
local HOOK,WINHOOK=0x6052F4,0x5EF27A
local function fail(t) error(t,0) end
local function need(v,t) if not v then fail(t) end return v end
local function rb(a,n) return readBytes(a,n,true) end
local function equal(a,b) if not a or #a~=#b then return false end for i=1,#b do if a[i]~=b[i] then return false end end return true end
local function bytes(hex) local b={} for h in hex:gmatch('%x%x') do b[#b+1]=tonumber(h,16) end return b end
local function put32(b,o,v) v=v%0x100000000 for i=1,4 do b[o+i]=v%256;v=math.floor(v/256) end end
local function put(a,b) need(writeBytes(a,b)==#b,'Memory write failed.');need(equal(rb(a,#b),b),'Memory readback failed.') end
local function wi(a,v) need(writeInteger(a,v),'Integer write failed.') end
local function wf(a,v) need(writeFloat(a,v),'Float write failed.') end
local function jump(a,b) local t={0xE9,0,0,0,0};put32(t,1,b-a-5);return t end
local function winjump(code) local t=jump(WINHOOK,code+MANIFEST.key_hook_offset);t[6]=0x90;return t end
local function state(o) return S.data and readInteger(S.data+o) end
local function fnv(b) local h=0x811C9DC5 for _,v in ipairs(b) do h=((h ~ v)*0x01000193)&amp;0xFFFFFFFF end return h end
local function expected(code,data)
 local b=bytes(MANIFEST.bytes)
 for _,r in ipairs(MANIFEST.relocations) do
  local v
  if r.kind=='data' then v=data+r.add elseif r.kind=='module' then v=0x400000+r.add elseif r.kind=='code' then v=code+r.add elseif r.kind=='size' then v=MANIFEST.size+r.add elseif r.kind=='relative_module' then v=0x400000+r.add-(code+r.offset+4) else fail('Unknown relocation.') end
  put32(b,r.offset,v)
 end
 return b
end
local ROWS=(function()
-- Bener Kaya / Deity Zenith: STANDARD CE ROWS, pure settings/filter controller.
-- Pure ordinary-row controller. Native lifecycle is provided by the engine.
local S={version='test12-rows',bound=false,settings={civ=1,kind=0,summon=307,side=-1,count=1,where=0,x=10.5,y=10.5,key=0x70}}
local IDS={root=400,civ=410,kind=411,summon=412,side=413,count=414,where=415,x=416,y=417,key=418,status=431,diagnostics=430}
local list=getAddressList();S.records={}
for name,id in pairs(IDS) do S.records[name]=assert(list.getMemoryRecordByID(id),'Missing row '..name) end
local function dropdown(row,text)
 row.DropDownList.Text=text;row.DropDownReadOnly=true;row.DropDownDescriptionOnly=true;row.DisplayAsDropDownListItem=true
end
function S.filter(civ,kind,selected)
 local c=CATALOGUE[civ];assert(c and c.id==civ,'Invalid civilization')
 local name=({'Units','Buildings','Heroes'})[kind+1];assert(name,'Invalid summon type')
 local rows={} for _,r in ipairs(c.lists[name]) do rows[#rows+1]={id=r.id,name=r.name} end
 table.sort(rows,function(a,b)local x,y=a.name:lower(),b.name:lower();if x~=y then return x&lt;y elseif a.name~=b.name then return a.name&lt;b.name else return a.id&lt;b.id end end)
 local valid,regular=false,nil;local text={}
 for _,r in ipairs(rows) do valid=valid or r.id==selected;if r.id==307 then regular=307 end;text[#text+1]=r.id..':'..r.name..'  [#'..r.id..']' end
 local pick=valid and selected or regular or (rows[1] and rows[1].id)
 return rows,pick,table.concat(text,'\n')
end
function S.whereVisibility(where)
 local row=S.records.where
 row.Options=where==1 and '[moAllowManualCollapseAndExpand]' or '[moAlwaysHideChildren]'
 row.Collapsed=where~=1
end
function S.refresh()
 local v=S.settings
 if S.bound then for _,k in ipairs({'civ','kind','summon','where'}) do v[k]=S.readSetting(k) end end
 local rows,pick,text=S.filter(v.civ,v.kind,v.summon);S.filtered=rows;dropdown(S.records.summon,text)
 if v.summon~=pick then v.summon=pick;if S.bound then S.writeSetting('summon',pick) end end
 -- Native editor: the Gaia list belongs to the Gaia player (slot 0).
 -- Only when the user SWITCHES to Gaia; later explicit Side edits are not silently
 -- overwritten (publication refuses Gaia source with a non-Gaia owner instead).
 if S.bound and v.civ==0 and S.lastCiv~=0 then
  local side=S.readSetting('side')
  if side~=0 then v.side=0;S.writeSetting('side',0) end
 end
 S.lastCiv=v.civ
 S.whereVisibility(v.where)
end
function S.bind(reader,writer,reset)
 -- The native engine supplies ONLY its separate UI-setting buffer here.
 -- Editable records must never alias the immutable native request payload.
 assert(type(reader)=='function' and type(writer)=='function');S.readSetting=reader;S.writeSetting=writer;S.bound=true
 if reset then for k,v in pairs(S.settings) do writer(k,v) end end S.refresh()
end
function S.status(text) S.records.status.Description='Status — '..text end
for _,name in ipairs({'civ','kind','where'}) do S.records[name].OnValueChangedByUser=function() if S.bound then S.refresh() end end end
for _,name in ipairs({'civ','kind','summon','side','count','where','x','y','key'}) do
 local key=name
 S.records[name].OnActivate=function(_,before) return not before end -- never freeze selector values
 S.records[name].OnGetDisplayValue=function(_,value)
  if S.bound then
   if key=='side' and (S.readSetting('side')==-1 or S.readSetting('side')==0xFFFFFFFF) then return true,'Current player' end
   return false,value
  end
  local v=S.settings[key]
  if key=='civ' then return true,CATALOGUE[v].name elseif key=='kind' then return true,({'Units','Buildings','Heroes'})[v+1] elseif key=='summon' then for _,r in ipairs(S.filtered or {}) do if r.id==v then return true,r.name..'  [#'..v..']' end end elseif key=='key' then return true,v==4 and 'Mouse middle button' or 'F'..(v-0x6F) elseif key=='side' and v==-1 then return true,'Current player' elseif key=='where' then return true,v==0 and 'Cursor on map' or 'Map tile X / Y' end
  return true,tostring(v)
 end
end
S.records.diagnostics.Collapsed=true;S.refresh();S.status('Disabled; enable root before editing settings.')
return S

end)()
S.rows=ROWS
local function notice(t) S.lastStatus=t;ROWS.status(t) end
local function hookState()
 local a,b=rb(HOOK,5),rb(WINHOOK,6)
 if equal(a,ORIGINAL) and equal(b,WINORIGINAL) then return 'stock' end
 if S.code and equal(a,jump(HOOK,S.code)) and equal(b,winjump(S.code)) then return 'ours' end
 return 'unknown'
end
local function integrity()
 need(getOpenedProcessID()==S.pid,'Attached process changed. Restart CE/table before enabling.')
 need(S.code and S.data and S.ui,'Not initialized.')
 local b=expected(S.code,S.data)
 need(equal(rb(S.code,#b),b),'Resident core integrity mismatch. Restart the game normally.')
 need(state(0)==0x53575A44 and state(0x3FFC)==0x5A454E31,'Native buffer canary mismatch.')
 need(state(0x1FC)==0x5049434B and state(0x214)==0x454E4450,'Native map-pick buffer guard mismatch.')
 need(state(0x10)==0x400000 and state(0xA0)==0x000C0001 and state(0xA4)==S.code and state(0xA8)==fnv(b),'Native ABI/code checksum mismatch.')
 need(state(0xAC)==S.ui and readInteger(S.ui+0xFFC)==0x55495A34,'UI buffer integrity mismatch.')
 need(hookState()~='unknown','Native hook site changed; refusing to overwrite another patch.')
 for _,sig in ipairs(PROFILE.native_signatures) do need(equal(rb(sig.address,#sig.hex/2),bytes(sig.hex)),'Native function/vtable signature mismatch.') end
 for i,rva in ipairs(MANIFEST.native_call_rvas) do need(state(0x100+(i-1)*4)==(rva==0xC2D10 and S.code+MANIFEST.source_factory_offset or 0x400000+rva),'Native call table mismatch.') end
 for i,a in ipairs({0x6542B0,0x6542F0,0x6542F4}) do
  local expected=S.importBaseline[i]
  need(readInteger(a)==expected,'Live original game OS import binding changed: '..PROFILE.cnc.functions[i].name)
  need(state(0xC0+(i-1)*4)==expected,'Saved import baseline buffer corrupted (game import unchanged): '..PROFILE.cnc.functions[i].name)
 end
 need(state(0xCC)==S.focusPointer and state(0xD0)==fnv(rb(S.data+0xC0,16)),'Trusted original focus pointer integrity mismatch.')
 if S.checkImports then S.checkImports() end
end
-- Only original target Windows imports or this EXACT cnc-ddraw build/functions.
local function resolveImports(modules,dir)
 local ranges={};local cnc;local cached=false
 local function norm(s) return s:gsub('/','\\'):lower() end
 for _,m in ipairs(modules) do
  local n=m.Name:lower()
  if n=='user32.dll' or n=='win32u.dll' or n=='aclayers.dll' or n=='apphelp.dll' or n=='ddraw.dll' then
   local ok,size=pcall(getModuleSize,m.Name)
   if ok and type(size)=='number' and type(m.Address)=='number' and m.Address&gt;=0x10000 and size&gt;0 and m.Address+size&lt;=0x100000000 and not m.Is64Bit then
    local r={module=m,name=n,base=m.Address,size=size};ranges[#ranges+1]=r
    if n=='ddraw.dll' then cnc=r end
   end
  end
 end
 local function owner(p)
  for _,r in ipairs(ranges) do if p&gt;=r.base and p&lt;r.base+r.size then return r end end
 end
 local function describe(p)
  if type(p)~='number' then return tostring(p) end
  for _,m in ipairs(modules) do
   local ok,size=pcall(getModuleSize,m.Name)
   if ok and type(size)=='number' and p&gt;=m.Address and p&lt;m.Address+size then return string.format('%08X (%s+%X, x64=%s)',p,m.Name,p-m.Address,tostring(m.Is64Bit)) end
  end
  return string.format('%08X (no loaded target module)',p)
 end
 local function windows(p,label)
  local r=type(p)=='number' and owner(p)
  need(r and r.name~='ddraw.dll',label..' is not a supported original target32 Windows pointer: '..describe(p))
  return p
 end
 local function signatures()
  if not S.cnc then return end
  local c=PROFILE.cnc
  local checks={} for _,f in ipairs(c.functions) do checks[#checks+1]=f end for _,f in ipairs(c.thunks) do checks[#checks+1]=f end
  for _,f in ipairs(checks) do
   local b=bytes(f.hex)
   for _,o in ipairs(f.relocations) do
    local v=0 for i=4,1,-1 do v=v*256+b[o+i] end
    put32(b,o,v+S.cnc.base-c.preferred_base)
   end
   need(equal(rb(S.cnc.base+f.rva,#b),b),'Verified cnc-ddraw '..(f.name or 'import thunk')..' code/signature changed. No unknown wrapper is accepted.')
  end
  for i,slot in ipairs(c.real_slots) do
   local t=c.thunks[i]
   local p=readInteger(S.cnc.base+t.iat_rva)
   windows(p,'cnc-ddraw original '..c.functions[i].name)
   local stored=readInteger(S.cnc.base+slot)
   need(stored==S.cnc.base+t.rva or stored==p,'cnc-ddraw original '..c.functions[i].name..' has an unsupported detour/trampoline.')
   if cached then need(p==S.cnc.real[i] and stored==S.cnc.stored[i],'cnc-ddraw original Windows binding changed.') else S.cnc.real[i]=p;S.cnc.stored[i]=stored end
  end
 end
 local function verifyCnc()
  if S.cnc then return end
  need(cnc and cnc.size==PROFILE.cnc.image_size,'Unsupported cnc-ddraw image size/architecture.')
  local path=cnc.module.PathToFile
  need(type(path)=='string' and norm(path)==norm(dir..'\\ddraw.dll'),'Wrapper must be the verified DDRAW.dll beside battlegrounds_x1.exe.')
  need(fileExists(path)==true,'Verified cnc-ddraw file is missing: '..path)
  local ok,h=pcall(md5file,path)
  need(ok and type(h)=='string' and h:lower()==PROFILE.cnc.md5,'Unsupported DDRAW.dll file hash. Only the supplied verified cnc-ddraw build is supported.')
  S.cnc={base=cnc.base,path=path,real={},stored={}};signatures();cached=true
 end
 S.cnc=nil;S.imports={};local wrapped={};local descriptions={}
 for i,slot in ipairs({0x6542B0,0x6542F0,0x6542F4}) do
  local p=readInteger(slot);local label=PROFILE.cnc.functions[i].name
  need(type(p)=='number' and p&gt;=0x10000 and p&lt;0x100000000,label..' original32-bit IAT is invalid/unreadable: '..describe(p))
  local r=owner(p)
  if r and r.name=='ddraw.dll' then
   verifyCnc();local f=PROFILE.cnc.functions[i]
   need(p==cnc.base+f.rva,label..' points to unsupported DDRAW.dll RVA '..string.format('%X',p-cnc.base)..'; expected '..string.format('%X',f.rva))
   wrapped[i]=true
  else windows(p,label);wrapped[i]=false end
  S.imports[i]=p;descriptions[#descriptions+1]=label..'='..(r and r.name or 'unknown')..(r and string.format('+%X',p-r.base) or '')
 end
 need(wrapped[2]==wrapped[3],'Mixed physical/virtual cursor imports rejected: GetCursorPos and ScreenToClient must use the same verified route.')
 S.focusPointer=wrapped[1] and S.cnc.real[1] or S.imports[1]
 windows(S.focusPointer,'Native real focus gate')
 S.checkImports=signatures;S.importDescription=table.concat(descriptions,'; ')
end

local function profile()
 need(not targetIs64Bit(),'Only a 32-bit game process is supported.')
 need(getCEVersion()&gt;=7.5,'Cheat Engine 7.5 or newer is required.')
 local pid=need(getOpenedProcessID(),'Manually attach CE to battlegrounds_x1.exe first.')
 need(pid~=0,'Manually attach CE to battlegrounds_x1.exe first.')
 need(not (debug_isDebugging and debug_isDebugging()),'Detach the CE debugger before enabling.')
 local mod
 local modules=enumModules()
 for _,m in ipairs(modules) do if m.Name:lower()=='battlegrounds_x1.exe' then mod=m end end
 need(mod and mod.Address==0x400000,'Only the verified 32-bit battlegrounds_x1.exe at its normal image base is supported.')
 local path=need(mod.PathToFile,'CE did not provide the executable file path.')
 need(type(path)=='string' and #path&gt;0,'CE did not provide a usable executable file path.')
 path=path:gsub('/','\\')
 local dir=need(path:match('^(.*)[/\\]'),'Executable folder unavailable.')
 local parent=dir:match('^(.*)[/\\]') or dir
 resolveImports(modules,dir)
 local function exists(candidate)
  local ok,present=pcall(fileExists,candidate)
  need(ok,'Cannot inspect required file: '..candidate)
  return present==true
 end
 local function verify(candidate,name)
  -- Do not call CE md5file on absent paths: pcall does not suppress its Lua Engine diagnostics.
  need(exists(candidate),'Missing required '..name..':\n'..candidate)
  local ok,h=pcall(md5file,candidate)
  need(ok and type(h)=='string' and #h==32,'Cannot read/hash required '..name..':\n'..candidate)
  need(h:lower()==PROFILE.file_md5[name],'Integrity mismatch for '..name..':\n'..candidate..'\nExpected the uploaded unmodified build; no new hooks were installed by this attempt.')
 end
 verify(path,'battlegrounds_x1.exe')
 local function locate(name,candidates)
  local checked,seen={},{}
  for _,candidate in ipairs(candidates) do
   local key=candidate:lower()
   if not seen[key] then
    seen[key]=true;checked[#checked+1]=candidate
    if exists(candidate) then verify(candidate,name);return candidate end
   end
  end
  fail('Missing required '..name..'. Checked:\n'..table.concat(checked,'\n')..'\nKeep the original game files in place; no new hooks were installed by this attempt.')
 end
 -- Verified Steam layout: Game\Data\genie_x1.dat; language DLLs beside the EXE in Game.
 -- Legacy candidates remain existence-checked. Never fall back past an existing mismatched file.
 locate('genie_x1.dat',{dir..'\\Data\\genie_x1.dat',dir..'\\genie_x1.dat',parent..'\\Data\\genie_x1.dat',parent..'\\genie_x1.dat'})
 for _,name in ipairs({'language.dll','language_x1.dll'}) do
  locate(name,{dir..'\\'..name,dir..'\\Data\\'..name,parent..'\\'..name,parent..'\\Data\\'..name})
 end
 -- Hash every byte of decoded .text except the two intentional single-instruction hook windows.
 for _,span in ipairs(PROFILE.text_spans) do
  need(md5memory(span.address,span.size):lower()==span.md5,'Loaded game code differs from the verified unpacked build. Other patches/compatibility mods are unsupported.')
 end
 return pid
end
local function session(running)
 local g=need(readInteger(0x6A3684),'Game object unavailable.')
 need(g~=0,'Game object unavailable.')
 need(readBytes(g+0x9AD,1)==1 and readBytes(g+0x9AE,1)==0,'Offline single-player only.')
 local mode=readInteger(g+0x1DC);need(mode and mode&gt;=4 and mode&lt;=6,'Enter a single-player match first.')
 local world=need(readInteger(g+0x420),'World unavailable.');need(world~=0 and readBytes(world+0x29,1)==0,'World not active.')
 if running then
  -- Exact get_paused(1) semantics for allowed modes: comms.IsPaused == (state==4).
  -- world+0xA8 is reset on EVERY update and may legitimately be zero while running.
  local comm=need(readInteger(g+0x1B4),'Native pause controller unavailable.')
  need(comm~=0,'Native pause controller unavailable.')
  local pauseState=need(readInteger(comm+0x1E3C),'Native pause state unavailable.')
  need(pauseState~=4,'Game reports paused (native state 4). Resume the game or close its pause/menu dialog first.')
 end
 local screen=need(readInteger(g+0x17B4),'Game screen unavailable.');need(screen~=0,'Game screen unavailable.')
 local replay=readInteger(screen+0x1144);need(replay and (replay==0 or readInteger(replay+0x6C)==0),'Replays are not supported.')
 return world
end

local function stopEvents()
 if S.hotkey then S.hotkey.destroy();S.hotkey=nil end
 if S.timer then S.timer.destroy();S.timer=nil end
end
-- Game-closed safety (user report t207u): after the game exits CE can stay attached to the
-- dead PID, so a PID compare alone passes and the next game-memory write fails and makes CE
-- show an integer-write message. processAlive() is dialog-free: PID compare, CE symbol
-- lookup (getAddressSafe never raises) and one pcall'd NUMERIC canary read, which returns nil
-- instead of raising/showing a dialog when the address space is gone. No writes.
local function processAlive()
 local pid=getOpenedProcessID()
 if not pid or pid==0 or not S.pid or pid~=S.pid then return false end
 if S.data then
  if getAddressSafe('DZSWGB_DATA_T9')~=S.data then return false end
  local ok,v=pcall(readInteger,S.data)
  if not ok or v~=0x53575A44 then return false end
 end
 return true
end
S.processAlive=processAlive
-- The process is gone or changed: never touch game/injected memory (no reads/writes, no hook
-- restore, no pause), never showMessage. Stop the timer FIRST; destroy the hotkey only when
-- not inside its own callback (test9 CE deadlock rule). Only CE-side state is changed.
local function abandon(text)
 S.enabled=false;S.deferredDisable=nil
 if S.timer then local t=S.timer;S.timer=nil;t.Enabled=false;t.destroy() end
 if S.hotkey and not S.inHotkey then local h=S.hotkey;S.hotkey=nil;h.destroy() end
 S.trusted=false;S.hooked=false;S.code=nil;S.data=nil;S.ui=nil;S.pid=nil;S.importBaseline=nil;S.requestTime=nil;S.held=false
 ROWS.bound=false
 for _,name in ipairs({'DZSWGB_CODE_T9','DZSWGB_DATA_T9','DZSWGB_UI_T9'}) do if unregisterSymbol then pcall(unregisterSymbol,name) end end
 if ROWS.records.root.Active then ROWS.records.root.disableWithoutExecute() end
 notice(text)
end
local GONE='Game closed or detached; Deity Zenith disabled without touching game memory. Close/restart Cheat Engine normally before the next game.'
local function patchSites(installing)
 local wanted=installing and 'stock' or 'ours'
 local beforeA=installing and ORIGINAL or jump(HOOK,S.code)
 local beforeB=installing and WINORIGINAL or winjump(S.code)
 local afterA=installing and jump(HOOK,S.code) or ORIGINAL
 local afterB=installing and winjump(S.code) or WINORIGINAL
 if not installing and hookState()=='stock' then S.hooked=false;return end
 need(hookState()==wanted,'Unexpected hook bytes; no unknown patch will be overwritten.')
 pause()
 local began=false
 local ok,e=pcall(function()
  need(equal(rb(HOOK,5),beforeA) and equal(rb(WINHOOK,6),beforeB),'Hook changed while pausing.')
  began=true;put(HOOK,afterA);put(WINHOOK,afterB)
 end)
 if not ok and began then
  local restored,why=pcall(function() if not equal(rb(HOOK,5),beforeA) then put(HOOK,beforeA) end;if not equal(rb(WINHOOK,6),beforeB) then put(WINHOOK,beforeB) end end)
  if not restored then fail('Hook rollback failed: process deliberately left paused. Do not resume it. '..tostring(why)) end
 end
 unpause();need(ok,e);S.hooked=installing
end
local function disable(text)
 -- CE deadlock (proven from CE hotkeyhandler.pas): a generic hotkey callback runs via
 -- Synchronize while the hotkey thread HOLDS CSKeys; TGenericHotkey.destroy -&gt;
 -- UnregisterGenericHotkey -&gt; CSKeys.Enter then waits forever and freezes CE's UI thread.
 -- Never destroy the hotkey from inside its own callback: stop publishing now and let the
 -- 100 ms timer perform the real disable on the next tick.
 if S.inHotkey then S.enabled=false;S.deferredDisable=S.deferredDisable or text or 'Disabled.';notice(S.deferredDisable);return end
 if S.disabling then return end
 if S.trusted and not processAlive() then abandon(GONE);return end
 S.disabling=true;S.enabled=false;S.deferredDisable=nil;stopEvents()
 local errorText
 if S.trusted and S.data and getOpenedProcessID()==S.pid then
  local ok,e=pcall(function() wi(S.data+4,0);wi(S.data+0x84,1);patchSites(false) end)
  if not ok then errorText=tostring(e) end
 end
 S.disabling=false
 if ROWS.records.root.Active then ROWS.records.root.disableWithoutExecute() end
 notice(errorText or text or 'Disabled; original native instructions restored. Resident buffers retained until game exit.')
 if errorText and processAlive() then showMessage(errorText) end
end
S.disable=disable
local uiOffsets={civ=0,kind=4,summon=8,side=12,count=16,where=20,x=24,y=28,key=32}
local function readSetting(k)
 local v=(k=='x' or k=='y') and readFloat(S.ui+uiOffsets[k]) or readInteger(S.ui+uiOffsets[k])
 if k=='side' and v==0xFFFFFFFF then return -1 end return v
end
local function writeSetting(k,v) if k=='x' or k=='y' then wf(S.ui+uiOffsets[k],v) else wi(S.ui+uiOffsets[k],v) end end
local function bindUI(reset)
 for name,address in pairs({DZSWGB_CODE_T9=S.code,DZSWGB_DATA_T9=S.data,DZSWGB_UI_T9=S.ui}) do
  local existing=getAddressSafe(name)
  if existing then need(existing==address,'Conflicting resident symbol; restart CE.') else registerSymbol(name,address,true) end
 end
 ROWS.bind(readSetting,writeSetting,reset)
end
local function checkLayout()
 local pages={{S.code,0x4000},{S.data,0x4000},{S.ui,0x1000}}
 for i,p in ipairs(pages) do
  need(p[1]&gt;=0x10000 and p[1]%16==0 and p[1]+p[2]&lt;0x100000000,'Invalid allocation layout.')
  need(p[1]+p[2]&lt;=0x400000 or p[1]&gt;=0x814000,'Allocation overlaps game image.')
  for j=1,i-1 do local q=pages[j];need(p[1]+p[2]&lt;=q[1] or q[1]+q[2]&lt;=p[1],'Allocation overlap.') end
 end
 need(MANIFEST.mouse_sequence_offset==0xD4 and MANIFEST.mouse_held_offset==0xD8 and 0xD0+4==0xD4 and 0xD8+4&lt;=0x100,'Native input mailbox overlaps protected state.')
 need(MANIFEST.pick_result_offset==0x200 and MANIFEST.pick_result_size==0x14 and 0x118&lt;=0x1FC and 0x200+0x14==0x214 and 0x218&lt;=0x400,'Native map-pick/control/FXSAVE layout overlap.')
 need(MANIFEST.size&lt;0x4000 and 0x800+289*8&lt;0x3FFC,'Compiled layout overflow.')
end
local function install()
 local pid=profile();S.importBaseline=S.importBaseline or S.imports;local h=hookState()
 if S.code then integrity();return end
 if h=='stock' then
  need(autoAssemble('alloc(DZSWGB_CODE_T9,$4000,battlegrounds_x1.exe)\nalloc(DZSWGB_DATA_T9,$4000,battlegrounds_x1.exe)\nalloc(DZSWGB_UI_T9,$1000,battlegrounds_x1.exe)\nregistersymbol(DZSWGB_CODE_T9)\nregistersymbol(DZSWGB_DATA_T9)\nregistersymbol(DZSWGB_UI_T9)'),'Allocation failed.')
  S.code=need(getAddressSafe('DZSWGB_CODE_T9'),'Code symbol unavailable.');S.data=need(getAddressSafe('DZSWGB_DATA_T9'),'Data symbol unavailable.');S.ui=need(getAddressSafe('DZSWGB_UI_T9'),'UI symbol unavailable.');S.pid=pid;checkLayout();S.trusted=true
  local zero={} for i=1,0x4000 do zero[i]=0 end put(S.data,zero)
  zero={} for i=1,0x1000 do zero[i]=0 end put(S.ui,zero)
  local b=expected(S.code,S.data);put(S.code,b)
  wi(S.data,0x53575A44);wi(S.data+0x3FFC,0x5A454E31);wi(S.data+0x10,0x400000)
  wi(S.data+0x70,HOOK+5);wi(S.data+0x80,WINHOOK+6);wi(S.data+0xA0,0x000C0001);wi(S.data+0xA4,S.code);wi(S.data+0xA8,fnv(b));wi(S.data+0xAC,S.ui);wi(S.ui+0xFFC,0x55495A34)
  for i,rva in ipairs(MANIFEST.native_call_rvas) do wi(S.data+0x100+(i-1)*4,rva==0xC2D10 and S.code+MANIFEST.source_factory_offset or 0x400000+rva) end
  for i,v in ipairs(S.imports) do wi(S.data+0xC0+(i-1)*4,v) end
  wi(S.data+0x1FC,0x5049434B);wi(S.data+0x214,0x454E4450)
  wi(S.data+0xCC,S.focusPointer);wi(S.data+0xD0,fnv(rb(S.data+0xC0,16)))
  local offsets={} for y=-8,8 do for x=-8,8 do offsets[#offsets+1]={x,y} end end
  table.sort(offsets,function(a,b)local x,y=math.max(math.abs(a[1]),math.abs(a[2])),math.max(math.abs(b[1]),math.abs(b[2]));if x~=y then return x&lt;y elseif a[2]~=b[2] then return a[2]&lt;b[2] else return a[1]&lt;b[1] end end)
  for i,p in ipairs(offsets) do wf(S.data+0x800+(i-1)*8,p[1]);wf(S.data+0x804+(i-1)*8,p[2]) end
  bindUI(true)
 else
  -- Only exact test12 resident code may be adopted. Earlier builds need game exit.
  local first=rb(HOOK,5);need(first and first[1]==0xE9,'Unknown/older native hooks. Restart the game and CE normally.')
  local delta=0 for i=5,2,-1 do delta=delta*256+first[i] end
  S.code=(HOOK+5+delta)%0x100000000
  local start=rb(S.code,7);need(start and start[1]==0x9C and start[2]==0x60 and start[3]==0xBF,'Unknown resident hook.')
  local data=0 for i=7,4,-1 do data=data*256+start[i] end
  S.data=data;S.pid=pid;need(readInteger(data+0xA0)==0x000C0001,'Older/unknown native core remains. Restart BOTH game and CE normally.');S.ui=need(readInteger(data+0xAC),'Resident UI unavailable.');checkLayout();integrity();S.trusted=true;bindUI(false)
 end
 integrity()
end
local function guarded(fn)
 local ok,e=pcall(fn);if not ok then disable(tostring(e)) end -- routine hotkey failures are status rows, not popups
end
local function validKey(v) return type(v)=='number' and (v==4 or (v&gt;=0x70 and v&lt;=0x7B and v%1==0)) end
local queue,tick,setkey
local function hotkeyPressed()
 -- CE generic-hotkey callback context: must never destroy this hotkey (see disable()).
 S.inHotkey=true
 local ok,e=pcall(queue)
 if not ok then disable(tostring(e)) end -- still inside the callback: deferred
 S.inHotkey=false
end
local function enable()
 -- Finish a refusal-deferred disable first (never inside a hotkey callback here).
 if S.deferredDisable then local text=S.deferredDisable;S.deferredDisable=nil;disable(text) end
 need(not S.enabled,'Already enabled.')
 local ok,e=pcall(function()
  local world=session(false);install();integrity();local vk=readSetting('key');need(validKey(vk),'Choose F1–F12 or Mouse middle button.')
  pause();local reset,why=pcall(function()
   wi(S.data+4,0);need(state(8)~=2,'Previous request is still finishing; wait before enabling.')
   wi(S.data+8,0);wi(S.data+0x84,0);wi(S.data+0x14,world);wi(S.data+0x7C,vk)
   wi(S.data+0xD4,0);wi(S.data+0xD8,0);wi(S.data+0x90,0);wi(S.data+0x94,256);wi(S.data+0x98,0);wi(S.data+0x9C,0)
  end);unpause();need(reset,why)
  if hookState()=='stock' then patchSites(true) end
  integrity();S.enabled=true;S.held=false;setkey()
  S.timer=createTimer(nil,false);S.timer.Interval=100;S.timer.OnTimer=tick;S.timer.Enabled=true
  wi(S.data+4,1);notice('Enabled. F1 default; choose Civilization → Summon Type → Summon. Offline validated, runtime acceptance pending. '..S.importDescription)
 end)
 if not ok then disable(tostring(e));fail(tostring(e)) end
end
S.enable=enable
queue=function()
 if not S.enabled or S.held then return end
 if not processAlive() then disable(GONE);return end -- inside a hotkey callback this defers
 S.held=true
 guarded(function()
  need(getForegroundProcess()==S.pid,'Focus the game before summoning.')
  integrity();local world=session(true);need(world==state(0x14),'Match changed; disable and enable again.')
  need(state(8)~=1 and state(8)~=2,'Previous request is still pending.')
  ROWS.refresh()
  local civ,kind,id=readSetting('civ'),readSetting('kind'),readSetting('summon')
  local count,side,where=readSetting('count'),readSetting('side'),readSetting('where')
  need(count and count%1==0 and count&gt;=1 and count&lt;=25,'Count must be 1–25.')
  need(side and side%1==0 and side&gt;=-1 and side&lt;=8,'Invalid owner slot.')
  need(where==0 or where==1,'Invalid Where selection.')
  local found for _,r in ipairs(ROWS.filtered) do if r.id==id then found=r;break end end need(found,'Summon is not in BOTH selected editor filters.')
  need(civ~=0 or side==0,'Gaia list objects are placed for Gaia, as in the native editor: set Side = Gaia / slot 0.')
  local x,y=0,0
  if where==1 then x,y=readSetting('x'),readSetting('y');need(x and y and x==x and y==y and x&gt;=0 and y&gt;=0 and x&lt;4096 and y&lt;4096,'Enter finite map tile X/Y (0–4095).') end
  wi(S.data+8,0);wi(S.data+0x84,0);wi(S.data+0xC,0);wi(S.data+0x18,side);wi(S.data+0x1C,id);wi(S.data+0x20,count);wi(S.data+0x24,where);wf(S.data+0x28,x);wf(S.data+0x2C,y);wi(S.data+0x74,civ)
  wi(S.data+0x9C,state(0x90));S.requestTime=getTickCount();wi(S.data+8,1) -- publish LAST
  notice('Queued '..count..' × '..found.name..'; waiting for an advancing game tick.')
 end)
end
setkey=function()
 if S.hotkey then S.hotkey.destroy();S.hotkey=nil end
 local vk=readSetting('key');need(validKey(vk),'Choose F1–F12 or Mouse middle button.')
 wi(S.data+0x7C,vk);wi(S.data+0xD8,0);S.mouseSeq=state(0xD4);S.held=false
 if vk~=4 then S.hotkey=createHotkey(hotkeyPressed,vk);S.hotkey.DelayBetweenActivate=500 end
end
ROWS.records.key.OnValueChangedByUser=function() if S.enabled then guarded(setkey) end end
for _,name in ipairs({'civ','kind','where'}) do ROWS.records[name].OnValueChangedByUser=function() if ROWS.bound then guarded(ROWS.refresh) end end end
ROWS.records.root.OnDestroy=function() disable('Table closed; native hooks disabled/restored.') end
tick=function()
 if (S.enabled or S.deferredDisable) and S.trusted and not processAlive() then abandon(GONE);return end
 if S.deferredDisable then local text=S.deferredDisable;S.deferredDisable=nil;disable(text);return end
 if not S.enabled then return end
 if getOpenedProcessID()~=S.pid then disable('Attached process changed; restart CE/table.');return end
 local ok,e=pcall(function()
  if readSetting('key')~=4 and not isKeyPressed(readSetting('key')) then S.held=false end
  if state(4)~=1 then disable('Native safety disabled spawning (result '..tostring(state(0xC))..', integrity '..tostring(state(0x98))..').');return end
  wi(S.data+0x94,(state(0x90)+256)%0x100000000)
  local req=state(8)
  if req==3 then
   local code=state(0xC);local messages={[2]='Done',[3]='Session/paused rejection',[4]='Focus changed',[5]='Owner unavailable',[6]='Master unavailable',[7]='Cursor/coordinates invalid',[8]='Count/object limit',[9]='Native allocation failed',[10]='Cancelled by pause/focus/input',[12]='Native integrity failure',[13]='Advancing-tick lease expired',[14]='Request tick age expired'}
   notice((messages[code] or 'Unknown result')..' — created '..tostring(state(0x30))..'; placement checks '..tostring(state(0x34))..'.');wi(S.data+8,0);S.requestTime=nil
  elseif req==1 and S.requestTime and (getTickCount()-S.requestTime)%0x100000000&gt;2500 then
   disable('No eligible advancing tick within 2.5 seconds; pending request cancelled.');return
  end
  local g=readInteger(0x6A3684);if not g or g==0 or readInteger(g+0x420)~=state(0x14) then disable('Match changed/ended; enter SP then enable again.');return end
  if readSetting('key')==4 then
   local seq=state(0xD4)
   if seq~=S.mouseSeq then
    S.mouseSeq=seq;local pending=state(8)
    if pending~=1 and pending~=2 then S.held=false;queue() end -- no overlapping/backlogged clicks
   end
  end
 end)
 if not ok then disable('Read/integrity failure: '..tostring(e)) end
end
DZSWGB=S;notice('Disabled. Manually attach to battlegrounds_x1.exe, enter offline SP, then tick Deity Zenith - Enable. No custom window.')

end
DZSWGB.enable()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if DZSWGB then DZSWGB.disable() end
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>402</ID>
          <Description>"---Summon Units/Buildings/Heroes---"</Description>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>410</ID>
              <Description>"Civilization"</Description>
